from typing import List, Dict, Union, Tuple, Optional, Iterator
from enum import Enum

class QwenError(RuntimeError): ...
class ConcurrencyError(QwenError): ...
class ContextWindowExceededError(QwenError): ...
class CudaOutOfMemoryError(QwenError): ...
class ModelNotFoundError(FileNotFoundError, QwenError): ...

class QuantMode(Enum):
    FP16: int
    W4A16: int

class ArenaStats:
    weights_bytes: int
    kv_cache_bytes: int
    workspace_bytes: int
    total_allocated_bytes: int
    device_free_bytes: int
    device_total_bytes: int
    mode: QuantMode

class ChatMessage:
    role: str
    content: str
    def __init__(self, role: str, content: str) -> None: ...

class NativeTokenizer:
    def __init__(self, tokenizer_bin_path: str) -> None: ...
    def encode(self, text: str) -> List[int]: ...
    def decode(self, tokens: List[int]) -> str: ...
    def decode_token(self, token_id: int) -> str: ...
    def decode_streaming(self, token_id: int, carry_buffer: str) -> str: ...
    def format_chatml(self, messages: Union[List[Dict[str, str]], List[ChatMessage], List[Tuple[str, str]]]) -> List[int]: ...
    def is_eos(self, token_id: int) -> bool: ...
    def vocab_size(self) -> int: ...

class NativeEngine:
    def __init__(self, qwenbin_path: str, device_id: int = 0) -> None: ...
    def prefill(self, tokens: List[int], temperature: float = 0.0) -> int: ...
    def decode_step(self) -> int: ...
    def rollback_to(self, target_seq_pos: int) -> None: ...
    def reset_session(self) -> None: ...
    def get_memory_stats(self) -> ArenaStats: ...
    def device_id(self) -> int: ...
    def current_seq_pos(self) -> int: ...
    def current_token_id(self) -> int: ...
    def try_acquire_session(self) -> bool: ...
    def release_session(self) -> None: ...
    def is_generating(self) -> bool: ...

class PyEngineStream:
    def __init__(
        self,
        engine: NativeEngine,
        tokenizer: NativeTokenizer,
        prompt_tokens_len: int,
        max_new_tokens: int = 256,
        rollback_on_interrupt: bool = True,
    ) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __next__(self) -> str: ...
    def close(self, rollback: bool = True) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def generated_count(self) -> int: ...

